{
  "name": "dsh-grill-me-toggle",
  "version": "0.2.0",
  "private": true,
  "description": "输入框旁的「追问」开关按钮：开启时把 /grill-me 放进草稿，关闭时摘掉，不重复添加，也绝不替你发送。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "SKILL.md",
    "install-skill.ps1"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "grill-me",
    "skill",
    "web-ui"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1"
  }
}
